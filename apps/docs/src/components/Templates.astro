---
/*
 * The seeded flows, rendered from TEMPLATES in @orderloop/core: the same builders the seed
 * publishes as version 1 of each flow. Each node links to its catalog entry.
 */
// biome-ignore lint/correctness/noUnusedImports: used in the markup
import { nodeSpec, ORDER_TYPE_LABELS, TEMPLATES } from '@orderloop/core';

// biome-ignore lint/correctness/noUnusedVariables: used in the markup
const flows = Object.values(TEMPLATES).map((t) => t());
---

{
  flows.map((f) => (
    <section class="ol-node" id={f.id}>
      <h3>
        {f.name}
        <code>{f.id}</code>
      </h3>
      <p>{f.description}</p>
      <ul class="ol-tags">
        <li>Order type: {ORDER_TYPE_LABELS[f.orderType]}</li>
        <li>{f.nodes.length} nodes</li>
        <li>{f.edges.length} edges</li>
      </ul>
      <details>
        <summary>Nodes</summary>
        <table>
          <thead>
            <tr>
              <th>Id</th>
              <th>Label</th>
              <th>Type</th>
            </tr>
          </thead>
          <tbody>
            {f.nodes.map((n) => (
              <tr>
                <td>
                  <code>{n.id}</code>
                </td>
                <td>{n.label}</td>
                <td>
                  <a href={`/reference/nodes/#${n.type}`}>{nodeSpec(n.type)?.label ?? n.type}</a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </details>
    </section>
  ))
}
