---
/*
 * A list of values straight from @orderloop/core, so prose never restates an enum by hand.
 * Renders inline code separated by commas, or a bulleted list with `list`.
 */
import {
  NODE_STATUSES,
  ORDER_STATUSES,
  ORDER_TYPES,
  OUTBOUND_EVENTS,
  POLICY_RULES,
  TERMINAL_ORDER_STATUSES,
} from '@orderloop/core';

const SOURCES = {
  'node-statuses': NODE_STATUSES,
  'order-statuses': ORDER_STATUSES,
  'terminal-order-statuses': TERMINAL_ORDER_STATUSES,
  'order-types': ORDER_TYPES,
  'outbound-events': OUTBOUND_EVENTS,
  'policy-rules': POLICY_RULES,
} as const;

interface Props {
  of: keyof typeof SOURCES;
  list?: boolean;
}

// biome-ignore lint/correctness/noUnusedVariables: `list` is used in the markup
const { of, list = false } = Astro.props;
// biome-ignore lint/correctness/noUnusedVariables: used in the markup
const values: readonly string[] = SOURCES[of];
---

{
  list ? (
    <ul>
      {values.map((v) => (
        <li>
          <code>{v}</code>
        </li>
      ))}
    </ul>
  ) : (
    values.map((v, i) => (
      <>
        {i > 0 && ', '}
        <code>{v}</code>
      </>
    ))
  )
}
