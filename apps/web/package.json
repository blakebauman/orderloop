{
  "name": "@orderloop/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Dashboard, flow editor, live order view, approvals and REST API: React Router on Workers.",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "deploy": "pnpm build && wrangler deploy",
    "types": "wrangler types && react-router typegen",
    "db:migrate:local": "wrangler d1 migrations apply orderloop --local",
    "db:seed:local": "wrangler d1 execute orderloop --local --file ../../packages/db/seed/0001_demo.sql",
    "db:seed:volume": "tsx scripts/seed-volume.ts",
    "db:seed:catalog": "tsx scripts/seed-catalog.ts",
    "db:migrate:remote": "wrangler d1 migrations apply orderloop --remote",
    "test": "vitest run",
    "lint": "biome check .",
    "check-types": "react-router typegen && tsc --noEmit",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@ai-sdk/react": "catalog:",
    "@cloudflare/ai-chat": "catalog:",
    "@cloudflare/workers-oauth-provider": "^1.2.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@orderloop/core": "workspace:*",
    "@orderloop/db": "workspace:*",
    "@orderloop/ui": "workspace:*",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "@xyflow/react": "^12.12.0",
    "agents": "catalog:",
    "ai": "catalog:",
    "drizzle-orm": "catalog:",
    "isbot": "^5.1.36",
    "jose": "6.2.12",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "^8.4.0",
    "recharts": "catalog:",
    "streamdown": "catalog:",
    "uqr": "0.1.3",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@orderloop/typescript-config": "workspace:*",
    "@playwright/test": "1.63.0",
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/vite": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
