{
  "name": "@orderloop/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Dashboard, flow editor, live order view, approvals and REST API: React Router on Workers.",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "deploy": "pnpm build && wrangler deploy",
    "types": "wrangler types && react-router typegen",
    "db:migrate:local": "wrangler d1 migrations apply orderloop --local",
    "db:migrate:remote": "wrangler d1 migrations apply orderloop --remote",
    "test": "vitest run",
    "lint": "biome check .",
    "check-types": "react-router typegen && tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/react": "catalog:",
    "@cloudflare/ai-chat": "catalog:",
    "@orderloop/core": "workspace:*",
    "@orderloop/db": "workspace:*",
    "@orderloop/ui": "workspace:*",
    "@xyflow/react": "^12.12.0",
    "agents": "catalog:",
    "ai": "catalog:",
    "drizzle-orm": "catalog:",
    "isbot": "^5.1.36",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "^8.4.0",
    "streamdown": "catalog:",
    "uqr": "0.1.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@orderloop/typescript-config": "workspace:*",
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/vite": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "^1.4.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
