{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orderloop-web",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-10-01",
  // global_fetch_strictly_public: MCP clients that identify by a Client ID Metadata Document
  // (an https client_id) are fetched from the public internet only.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "routes": [{ "pattern": "orderloop.io", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "orderloop",
      "database_id": "958e09f6-63a9-4634-ac1e-18ae3b7ce044",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  // Same bucket as the engine: the web app serves invoices, POs and inbound documents from it.
  "r2_buckets": [{ "binding": "DOCS", "bucket_name": "orderloop-docs" }],
  "services": [{ "binding": "ENGINE", "service": "orderloop-engine", "entrypoint": "EngineApi" }],
  // OAuth for MCP clients (@cloudflare/workers-oauth-provider): registered clients, grants and
  // tokens (hashed; props encrypted). No id: the namespace is created on first deploy.
  "kv_namespaces": [{ "binding": "OAUTH_KV" }],
  "vars": {
    // Inbound orders: JSON from "model:channel" or "model:*" to a flow id. Anything not routed
    // starts the model's default template.
    "ORDER_ROUTES": "",
    // EDI 850s: JSON from a trading partner's ISA sender id to the customer it orders for. A
    // sender not listed here is refused.
    "EDI_PARTNERS": ""
  }
  // Secrets (wrangler secret put): APP_PASSWORD — when set, the dashboard and API require it
  // (cookie for the UI, `Authorization: Bearer <password>` for /api/v1). WEBHOOK_SECRET — enables
  // signed events at POST /api/v1/webhooks/events and signed orders at POST /api/v1/webhooks/orders. SHOPIFY_WEBHOOK_SECRET — the
  // Shopify app's client secret; enables POST /api/v1/channels/shopify/orders.
}
