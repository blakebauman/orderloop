{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orderloop-catalog",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Reachable only through service bindings (the web app, catalog-edge): no workers.dev URL, no
  // routes.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "durable_objects": {
    "bindings": [
      // The source of truth: products and alias claims, 64 shards by key (core's productShard).
      { "name": "SHARD", "class_name": "CatalogShard" },
      // One object: product types, channels and categories.
      { "name": "META", "class_name": "CatalogMeta" },
      // One object: every feed's progress.
      { "name": "FEEDS", "class_name": "CatalogFeeds" },
      // One per channel and category: who is listed there, and its listing index.
      { "name": "LISTINGS", "class_name": "ListingIndexer" },
      // Keyword search, 16 shards by key (core's searchShard).
      { "name": "SEARCH", "class_name": "SearchShard" },
      // The storage writes of each shard's publishes, PUBLISH_FANOUT per shard (publisher.ts).
      { "name": "PUBLISHERS", "class_name": "CatalogPublisher" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CatalogShard", "CatalogMeta"] },
    { "tag": "v2", "new_sqlite_classes": ["CatalogFeeds"] },
    { "tag": "v3", "new_sqlite_classes": ["ListingIndexer"] },
    { "tag": "v4", "new_sqlite_classes": ["SearchShard"] },
    { "tag": "v5", "new_sqlite_classes": ["CatalogPublisher"] }
  ],
  "workflows": [
    {
      // Splits one feed file into shard parts, a chunk of products per step.
      "name": "orderloop-catalog-feed",
      "binding": "FEED_IMPORT",
      "class_name": "FeedImport",
      "limits": { "steps": 10000 }
    }
  ],
  "queues": {
    "producers": [
      { "binding": "FEED_PARTS", "queue": "orderloop-catalog-feed-parts" },
      // Cache tags of urgent changes, for catalog-edge to purge.
      { "binding": "PURGE", "queue": "orderloop-catalog-purge" },
      // What each publish changes in the listings, for the indexers.
      { "binding": "CHANGES", "queue": "orderloop-catalog-changes" }
    ],
    "consumers": [
      {
        // Each message is one feed part for one shard.
        "queue": "orderloop-catalog-feed-parts",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_retries": 4,
        // The consumer backs off per message (index.ts); this is the delay when an invocation
        // throws instead, which would otherwise redeliver at once.
        "retry_delay": 30,
        "dead_letter_queue": "orderloop-catalog-feed-parts-dlq"
      },
      {
        // Listing changes, a batch routed to its indexers at once.
        "queue": "orderloop-catalog-changes",
        "max_batch_size": 100,
        "max_batch_timeout": 2,
        "max_retries": 10,
        "retry_delay": 30,
        "dead_letter_queue": "orderloop-catalog-changes-dlq"
      },
      // The dead-letter queues, catalog-edge's purge one too: each message is kept in PUBLISHED
      // under dlq/ and logged (dead-letters.ts). They have no dead-letter queue of their own.
      {
        "queue": "orderloop-catalog-feed-parts-dlq",
        "max_batch_size": 100,
        "max_batch_timeout": 5,
        "max_retries": 10,
        "retry_delay": 60
      },
      {
        "queue": "orderloop-catalog-changes-dlq",
        "max_batch_size": 100,
        "max_batch_timeout": 5,
        "max_retries": 10,
        "retry_delay": 60
      },
      {
        "queue": "orderloop-catalog-purge-dlq",
        "max_batch_size": 100,
        "max_batch_timeout": 5,
        "max_retries": 10,
        "retry_delay": 60
      }
    ]
  },
  // Feed steps parse and validate thousands of products each.
  "limits": { "cpu_ms": 300000 },
  // Published documents (product docs, alias pointers, category trees, listing indexes), read by
  // catalog-edge. Strongly consistent, so a purge is never undone by a stale read.
  "r2_buckets": [{ "binding": "PUBLISHED", "bucket_name": "orderloop-catalog" }],
  // Order Loop's own database: the catalog keeps each variant's name and list price in `products`
  // (orders.ts). Migrations are the web app's; the catalog only writes those columns.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "orderloop",
      "database_id": "958e09f6-63a9-4634-ac1e-18ae3b7ce044"
    }
  ],
  // Listing cards, read in bulk by catalog-edge.
  "kv_namespaces": [{ "binding": "CARDS", "id": "7f9656f155a848b690457d2360700e0d" }],
  "vars": {
    // Where the shards keep their data (`eu`, `fedramp`), as the deployment's D1 and R2 do; set
    // from the registry. Empty leaves them where Cloudflare places them. Set it only before the
    // first product: changing it later strands what exists.
    "DATA_JURISDICTION": "",
    // Products a feed step reads before handing off to the next one (tests make it small).
    "FEED_CHUNK": "25000",
    // The channel whose prices (in the base currency) Order Loop's orders use: its variants are
    // kept in the `products` table.
    "ORDERS_CHANNEL": "web",
    // A minimum wait before a listing index builds. 0: a new category's index builds at once.
    // Tests set it to an hour and run builds themselves, so none is left running at teardown.
    "LISTING_DELAY_MS": "0",
    // Publishers each shard spreads its storage writes over: an invocation has only six writes in
    // flight, so this multiplies how fast a shard publishes (publisher.ts).
    "PUBLISH_FANOUT": "32"
  }
}
