// Static-assets Worker for the orderloop.app marketing page. No runtime code: Astro's dist/ is
// served as is.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orderloop-site",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Served only at the apex: no workers.dev or preview URL as a second address.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "orderloop.app", "custom_domain": true }]
}
