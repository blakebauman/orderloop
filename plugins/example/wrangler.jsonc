{
  "$schema": "node_modules/wrangler/config-schema.json",
  // A fixture for the plugin extension points (docs/plugins.md). scripts/fleet.ts refuses to
  // install it, so it is never deployed; the engine's and web app's tests bind it.
  "name": "orderloop-plugin-example",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // Its own database: the core's schema never holds a plugin's tables.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "orderloop-plugin-example",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
