// OrderLoop's own deployment at orderloop.app. Its resources keep the base names (suffix ""),
// which are the values in apps/*/wrangler.jsonc. See docs/operations.md for every field.
{
  "id": "orderloop",
  "ring": "internal",
  "slot": 1,
  "domain": "orderloop.app",
  "suffix": "",
  "environment": "production",
  "d1Id": "958e09f6-63a9-4634-ac1e-18ae3b7ce044",
  "catalogKvId": "7f9656f155a848b690457d2360700e0d",
  "docs": true,
  // Punchout from customers' procurement systems (plugins/punchout, docs/plugins.md#the-host-api):
  // sandboxed, so nothing to provision. It opens carts for their buyers, and starts and cancels
  // their POs.
  "plugins": {
    // Its procurement URLs read https://orderloop.app/punchout/cxml/setup, not /plugins/punchout/.
    "punchout": {
      "alias": "/punchout/",
      "runtime": "sandboxed",
      "capabilities": ["carts:external", "orders:start", "orders:cancel"]
    }
  },
  // Admins may ask the assistant to draft business-rule plugins (docs/plugins.md, "Assistant-drafted
  // plugins"): logic only, run sandboxed, and live only once an admin approves one with a step-up
  // and every case passes. No publishers yet, so no signed uploads.
  "pluginInstalls": { "assistant": true }
}
